      "2": "Moderately Relevant (Related domain, partial skills, or transferable tools)",
      "1": "Marginally Relevant (Peripheral background, general analytical skills)",
      "0": "Irrelevant (Unrelated domain, non-occupational hobbies, or zero domain overlap)"
    },
    "classification_categories": {
      "RECOGNIZED_ELIGIBLE_MATCH": "Candidate is occupationally relevant, meets policy rules, and system taxonomy recognizes skills.",
